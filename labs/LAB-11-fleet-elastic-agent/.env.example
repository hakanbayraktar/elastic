# Kibana > Fleet'ten kopyaladiginiz iki deger (README Adim 2). Bu dosyayi .env adiyla kopyalayip doldurun:
#   cp .env.example .env && nano .env
# docker compose .env dosyasini kendiliginden okur. .env git'e girmez; token'lari paylasmayin.
FLEET_SERVER_SERVICE_TOKEN=buraya-service-token
FLEET_ENROLLMENT_TOKEN=buraya-enrollment-token

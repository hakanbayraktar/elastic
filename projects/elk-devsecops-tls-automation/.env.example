# ==============================================================================
# ELK Stack DevSecOps Full TLS/SSL Environment Configuration
# ==============================================================================

# Kullanıcı / Sunucu Öneki ve Alan Adı
STUDENT_ID=student101
DOMAIN_BASE=devopsatolyesi.com

# Servis FQDN Tanımlamaları
ELASTIC_FQDN=student101-elastic.devopsatolyesi.com
KIBANA_FQDN=student101-kibana.devopsatolyesi.com
LOGSTASH_FQDN=student101-logstash.devopsatolyesi.com

# Elastic Stack Sürümü
STACK_VERSION=9.5.5
CLUSTER_NAME=devsecops-cluster

# Kimlik Bilgileri ve Parolalar
ELASTIC_PASSWORD=DevOps2026!
KIBANA_PASSWORD=DevOps2026!
LOGSTASH_INTERNAL_PASSWORD=DevOps2026!
BEATS_SYSTEM_PASSWORD=DevOps2026!

# Bellek ve Heap Sınırları
ES_MEM_LIMIT=2147483648
KB_MEM_LIMIT=1073741824
LS_MEM_LIMIT=1073741824

# Ağ ve Port Ayarları
HTTP_PORT=80
HTTPS_PORT=443
ELASTIC_GATEWAY_PORT=9200
# Elasticsearch'in kendi HTTPS portu, yalniz 127.0.0.1 (Packetbeat ve dahili CA testi)
ELASTIC_DIRECT_PORT=9201
KIBANA_GATEWAY_PORT=5601
LOGSTASH_BEATS_PORT=5044

# Let's Encrypt / Certbot Ayarları
LETSENCRYPT_EMAIL=admin@devopsatolyesi.com
# 1: Staging (Test limiti yememek için), 0: Production gerçek sertifika
LETSENCRYPT_STAGING=0
